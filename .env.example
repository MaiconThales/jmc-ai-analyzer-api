# Copy to .env for local Compose use. Replace the password locally; do not commit
# .env or real credentials.
POSTGRES_DB=jmc_analyzer
POSTGRES_USER=jmc_analyzer
POSTGRES_PASSWORD=replace-with-a-local-secret

FRONTEND_PORT=4200
FRONTEND_ALLOWED_ORIGINS=http://localhost:4200
# Required external artifact: compiled Angular application, versioned and preferably pinned by digest.
# It must run as FRONTEND_USER; this repository does not contain the Angular source/image.
# FRONTEND_IMAGE=registry.example.com/jmc-dashboard:1.0.0@sha256:<digest>
# FRONTEND_USER=101:101

# The MCP artifact is provisioned externally; this repository intentionally does not invent a JAR.
MCP_ENABLED=false
MCP_ARTIFACT_PATH=
MCP_JAR_PATH=/opt/mcp/mcp-server-jmc.jar
MCP_ARTIFACT_VERSION=
MCP_JAR_SHA256=
MCP_COMMAND=java
MCP_ARGUMENTS=-jar,/opt/mcp/mcp-server-jmc.jar
MCP_STARTUP_TIMEOUT=5s

ANALYSIS_MAX_CONCURRENT=2
ANALYSIS_STAGE_TIMEOUT=30s
ANALYSIS_SESSION_TIMEOUT=2m

# Optional: docker compose -f docker-compose.yml -f docker-compose.ai.yml --profile ai up -d
# AI profile requires all of these values and a non-root-capable provisioned image.
# AI_IMAGE=registry.example.com/jmc-ai:1.0.0@sha256:<digest>
# AI_USER=10001:10001
# AI_ENABLED is set to true by docker-compose.ai.yml; do not silently enable it in the base stack.
AI_PROVIDER=provider-neutral
AI_BASE_URL=http://ai:11434/v1/chat/completions
AI_MODEL=
AI_TIMEOUT=30s
AI_RETRY_MAX_ATTEMPTS=2
AI_PROMPT_VERSION=analysis-prompt-v1
# AI_API_KEY=
# AI_IMAGE=ollama/ollama:0.12.6
