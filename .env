FRONTEND_IMAGE=jmc-ai-analyzer-web:1.0.0
FRONTEND_USER=101:101
FRONTEND_PORT=4200
FRONTEND_ALLOWED_ORIGINS=http://localhost:4200

POSTGRES_DB=jmc_analyzer
POSTGRES_USER=jmc_analyzer
POSTGRES_PASSWORD=jmc_local_secret_123

MCP_ENABLED=true
MCP_ARTIFACT_PATH=C:/Development_Environment/Projects/mcp-server-jmc/target/mcp-server-jmc-0.1.1.jar
MCP_JAR_PATH=/opt/mcp/mcp-server-jmc.jar
MCP_ARTIFACT_VERSION=0.1.1
MCP_JAR_SHA256=3325d80c25d7ae41fc2e83a0b514489943458fef3408bf898c3d1432b4126f07
MCP_COMMAND=java
MCP_ARGUMENTS=-jar,/opt/mcp/mcp-server-jmc.jar
MCP_STARTUP_TIMEOUT=15s

ANALYSIS_MAX_CONCURRENT=2
ANALYSIS_STAGE_TIMEOUT=30s
ANALYSIS_SESSION_TIMEOUT=2m

AI_ENABLED=false
AI_PROVIDER=provider-neutral
AI_BASE_URL=http://ai:11434/v1/chat/completions
AI_MODEL=default
AI_TIMEOUT=30s
AI_RETRY_MAX_ATTEMPTS=2
AI_PROMPT_VERSION=analysis-prompt-v1
AI_API_KEY=